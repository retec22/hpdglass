NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://www.hpdglass.com
DATABASE_URL=postgresql://user:password@db.example.com:5432/hpd_projects
DATABASE_SSL=true
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=replace-on-server-only
JWT_ISSUER=https://api.hpdglass.com
JWT_AUDIENCE=hpd-command-center
JWT_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-a-long-random-secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
WEBHOOK_VERIFY_TOKEN=replace-with-provider-verification-token
META_APP_SECRET=replace-on-server-only
WHATSAPP_ACCESS_TOKEN=replace-on-server-only
WHATSAPP_PHONE_NUMBER_ID=replace-on-server-only
TIKTOK_CLIENT_KEY=replace-on-server-only
TIKTOK_CLIENT_SECRET=replace-on-server-only
TIKTOK_WEBHOOK_SECRET=replace-after-provider-approval
CORS_ORIGINS=https://www.hpdglass.com
TRUST_PROXY=1
